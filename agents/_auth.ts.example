// Auth helpers. Token sources, in priority order:
// 1. context.env.MCP_BEARER_TOKEN (logged-in deploys: `edgeone makers env set MCP_BEARER_TOKEN ...`)
// 2. FALLBACK_TOKEN baked at deploy time (anonymous deploys skip env injection).
// The fallback file is gitignored; rotation = regenerate + redeploy.

export const FALLBACK_TOKEN = "REPLACE_WITH_RANDOM_TOKEN";

export function checkAuth(provided: string | undefined, envToken: string | undefined): boolean {
  const expected = envToken && envToken.length > 0 ? envToken : FALLBACK_TOKEN;
  if (typeof provided !== 'string' || provided.length === 0) return false;
  if (provided.length !== expected.length) return false;
  // constant-time-ish compare
  let diff = 0;
  for (let i = 0; i < expected.length; i++) diff |= provided.charCodeAt(i) ^ expected.charCodeAt(i);
  return diff === 0;
}

export function bearerFrom(headers: Record<string, string>): string | undefined {
  const h = headers['authorization'] ?? headers['Authorization'];
  if (!h) return undefined;
  const m = /^Bearer\s+(.+)$/i.exec(h);
  return m ? m[1].trim() : undefined;
}

// SSRF guard: block loopback / private / link-local targets for browser navigation.
export function isPrivateTarget(rawUrl: string): boolean {
  let u: URL;
  try {
    u = new URL(rawUrl);
  } catch {
    return true;
  }
  if (u.protocol !== 'http:' && u.protocol !== 'https:') return true;
  const host = u.hostname.toLowerCase();
  if (host === 'localhost' || host.endsWith('.localhost') || host.endsWith('.internal') || host.endsWith('.local')) return true;
  if (/^\d{1,3}(\.\d{1,3}){3}$/.test(host)) {
    const o = host.split('.').map(Number);
    if (o[0] === 0 || o[0] === 10 || o[0] === 127) return true;
    if (o[0] === 169 && o[1] === 254) return true;
    if (o[0] === 172 && o[1] >= 16 && o[1] <= 31) return true;
    if (o[0] === 192 && o[1] === 168) return true;
    if (o[0] === 100 && o[1] >= 64 && o[1] <= 127) return true;
    if (o[0] >= 224) return true;
  }
  if (host === '::1' || host === '[::1]' || host.startsWith('fc') || host.startsWith('fd') || host.startsWith('fe80')) return true;
  return false;
}
